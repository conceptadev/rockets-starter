# Node Environment
NODE_ENV=development

# SQLite database file (relative to apps/api when running locally)
DATABASE_PATH=rockets-starter.sqlite

# Application Configuration
PORT=3001
SWAGGER_UI_PATH=api
ENABLE_GLOBAL_GUARD=true

# Microsoft 365 (Entra ID) auth — values from the company App Registration
# Tenant ID: Entra admin center > Overview > Tenant ID
# Client ID: Entra admin center > App registrations > Application (client) ID
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# Database Migrations and Seeding
# Run migrations: yarn migration:run
# Generate migration: yarn migration:generate ./src/migrations/MigrationName
# Revert migration: yarn migration:revert
# Seed database: yarn seed:run
# Initialize database: yarn sandbox:init (runs migrations + seeding)
