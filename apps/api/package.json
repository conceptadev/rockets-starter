{
  "name": "api",
  "version": "0.0.1",
  "description": "Rockets Starter API \u2014 NestJS 11 backend with TypeORM, SQLite, and Microsoft 365 (Entra ID) auth.",
  "author": "BTWLD",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "kill-port 3001 && nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm -d ./dist/ormconfig.js",
    "schema:drop": "yarn typeorm schema:drop",
    "schema:sync": "yarn typeorm schema:sync",
    "migration:create": "yarn typeorm migration:create",
    "migration:generate": "yarn build && yarn typeorm migration:generate",
    "migration:show": "yarn typeorm migration:show",
    "migration:run": "yarn build && yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:rebuild": "yarn schema:drop && yarn migration:run"
  },
  "dependencies": {
    "@bitwild/rockets": "1.0.0-alpha.9",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/platform-express": "12.0.0-alpha.5",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@nestjs/typeorm": "11.0.0",
    "@stargate/server": "file:../../../../stargate/packages/server",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/)"
    ],
    "moduleNameMapper": {
      "^@nestjs/swagger$": "<rootDir>/../test/swagger.shim.js",
      "^@stargate/server$": "<rootDir>/../test/stargate-server.shim.js",
      "^@stargate/server/nest$": "<rootDir>/../test/stargate-server-nest.shim.js",
      "^@stargate/engine$": "<rootDir>/../test/stargate-engine.shim.js",
      "load-package\\.util\\.js$": "<rootDir>/../test/load-package.shim.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
