{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": [
    "<rootDir>/setup-e2e.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "tsconfig": {
          "allowJs": true,
          "esModuleInterop": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@nestjs/)"
  ],
  "moduleNameMapper": {
    "load-package\\.util\\.js$": "<rootDir>/load-package.shim.js"
  }
}
