      "parameters": {
        "expression": "{ prompt: join('', ['Resuma o texto a seguir em portugues, em no maximo 3 frases. Responda apenas com o resumo, sem preambulo. Texto: ', text]) }"
      },
      "disabled": false
    },
    {
