{
  "name": "rockets-starter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-nestjs-alpha.js",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=web",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.7",
    "turbo": "^1.10.7"
  },
  "packageManager": "yarn@1.22.19",
  "resolutions": {
    "@concepta/rockets": "0.0.1-dev.0",
    "@concepta/rockets-core": "0.0.1-dev.0",
    "@concepta/rockets-repository-typeorm": "0.0.1-dev.0",
    "@stargate/ai_sdk": "file:../../stargate/packages/ai_sdk",
    "@stargate/components": "file:../../stargate/packages/components",
    "@stargate/core": "file:../../stargate/packages/core",
    "@stargate/engine": "file:../../stargate/packages/engine",
    "@stargate/server": "file:../../stargate/packages/server",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@nestjs/config": "12.0.0-next.0",
    "@nestjs/platform-express": "12.0.0-alpha.5",
    "@nestjs/testing": "12.0.0-alpha.5",
    "typeorm": "0.3.20",
    "@concepta/typeorm-seeding/typeorm": "0.3.20",
    "uuid": "^11.1.0",
    "@types/uuid": "^10.0.0",
    "zod": "^4.3.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.3",
    "@vitest/coverage-v8": "^3.1.3",
    "@vitest/ui": "^3.1.3",
    "@types/node": "^20.0.0",
    "glob": "10.5.0",
    "js-yaml": "4.1.1",
    "tar": "7.5.2",
    "tmp": "0.2.4",
    "string-width": "4.2.3",
    "strip-ansi": "6.0.1",
    "wrap-ansi": "7.0.0"
  }
